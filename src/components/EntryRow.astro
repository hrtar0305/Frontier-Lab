---
import { SECTIONS, type SectionKey } from '../consts';
import { formatDate, isoDate } from '../lib/format';
import { href } from '../lib/url';

interface Props {
	section: SectionKey;
	path: string;
	title: string;
	description: string;
	date: Date;
	draft?: boolean;
	// 여러 구역이 섞인 목록(홈)에서만 구역 라벨을 보여 준다.
	showSection?: boolean;
}

const { section, path, title, description, date, draft = false, showSection = false } = Astro.props;
---

<li class:list={['entry', { 'no-section': !showSection }]} data-section={section}>
	<div class="head">
		<time class="meta" datetime={isoDate(date)}>{formatDate(date)}</time>
		{showSection && <span class="label sec">{SECTIONS[section].label}</span>}
	</div>
	<div>
		<h3><a href={href(path)}>{title}</a></h3>
		<p class="desc">{description}</p>
		{
			(draft || Astro.slots.has('default')) && (
				<div class="extra">
					{draft && <span class="badge draft pending">초안 · 배포에서는 숨김</span>}
					<slot />
				</div>
			)
		}
	</div>
</li>
